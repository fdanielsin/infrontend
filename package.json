{
	"name": "infrontend",
	"private": true,
	"version": "1.2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''; git config core.hooksPath .githooks 2>/dev/null || true",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:coverage": "bun run test -- --coverage",
		"api:generate": "openapi-typescript \"${OPENAPI_URL:-http://localhost:8080/openapi.yaml}\" -o src/lib/api/schema.d.ts && openapi-ts",
		"api:check": "openapi-typescript \"${OPENAPI_URL:-http://localhost:8080/openapi.yaml}\" -o node_modules/.cache/schema.check.d.ts && diff -u src/lib/api/schema.d.ts node_modules/.cache/schema.check.d.ts && openapi-ts -o node_modules/.cache/zod && diff -u src/lib/api/zod/zod.gen.ts node_modules/.cache/zod/zod.gen.ts",
		"mutate": "stryker run",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run",
		"test:e2e": "playwright test",
		"test:e2e:mocked": "E2E_MOCKED_ONLY=1 playwright test",
		"verify": "svelte-kit sync && bun run i18n:compile && bun run lint && bun run check && bun run test:coverage && bun run build"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@hey-api/openapi-ts": "0.99.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@inlang/plugin-message-format": "^4.4.4",
		"@playwright/test": "^1.63.0",
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/vitest-runner": "^10.0.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24",
		"@vitest/coverage-v8": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^30.0.1",
		"openapi-typescript": "^7.13.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"zod": "^4.6.5"
	},
	"dependencies": {
		"openapi-fetch": "^0.17.0"
	},
	"overrides": {
		"cookie": "0.7.0",
		"devalue": "5.9.3",
		"js-yaml": "4.3.2",
		"qs": "6.16.0",
		"source-map-js": "1.2.2"
	}
}
